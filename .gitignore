# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
.cache/
*.pem

# Local agent / IDE worktrees (binaries here poison Tailwind CSS with NULs)
.claude/
.cursor/

# Nested git worktrees checked out inside this folder — never commit them.
/CELEVENTIC-event-guide/
/CELEVENTIC-femmora/
/CELEVENTIC-memory-vault/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env*.local
.env.production
credentials.json
**/secrets/**
*.key
*.p12
*.pfx
logs/
*.log

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma
prisma/*.db
prisma/*.db-journal
prisma/*.db-wal
prisma/*.db-shm

# local user uploads (folder structure kept via .gitkeep)
public/uploads/**
!public/uploads/
!public/uploads/**/
!public/uploads/**/.gitkeep

# video backfill runtime state (manifests, audit logs, SQLite backups, rollback files) —
# never committed; regenerated per run, may contain local file paths/DB content.
/var/video-backfill/

# media audit + URL-fix runtime state (reports, dry-runs, rollback manifests)
/var/media-audit/
/var/media-url-fix/

# invitation link repair backups (scripts/audit-invitation-links.ts --repair).
# These hold real uniqueLink bearer tokens so they must never be committed.
.backups/

# celeventic-video-worker liveness heartbeat (src/lib/video/worker-heartbeat.ts) — runtime state, regenerated every tick.
/var/video-worker/

/test-results/
/playwright-report/
/e2e/screenshots/
/e2e/fixtures/

# Alternate Next build output dirs (NEXT_DIST_DIR — see next.config.ts).
# Used to verify a production build without clobbering the .next that a running
# dev server or `next start` is serving from.
.next-ship-check/
.next-verify/
.next-live-ready/
.next-github-verify/

# Root SQLite copies (Prisma file:./dev.db also resolves under prisma/)
/dev.db
/dev.db-journal
/dev.db-wal
/dev.db-shm

# Build fingerprint written by scripts/write-build-meta.mjs (repo root copy)
.celeventic-build-meta.json
