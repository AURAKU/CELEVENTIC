{
    "name": "celeventic",
    "version": "0.1.0",
    "private": true,
    "engines": {
        "node": ">=20.20.2"
    },
    "browserslist": [
        "defaults",
        "iOS >= 15",
        "Safari >= 15",
        "Chrome >= 90",
        "Firefox >= 90",
        "Samsung >= 15",
        "not dead"
    ],
    "scripts": {
        "dev": "next dev",
        "dev:3000": "next dev -p 3000",
        "dev:turbo": "next dev --turbopack",
        "build": "next build",
        "build:clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\" && next build",
        "start": "next start",
        "start:3000": "next start -p 3000",
        "lint": "next lint",
        "lint:tokens": "node scripts/check-token-purity.mjs",
        "lint:uniqueness": "tsx scripts/check-template-uniqueness.ts",
        "db:generate": "prisma generate",
        "db:push": "prisma db push",
        "db:migrate": "prisma migrate dev",
        "db:seed": "tsx prisma/seed.ts",
        "db:seed-wave1": "tsx scripts/seed-wave1-catalog.ts",
        "invitation-features:backfill": "tsx scripts/backfill-invitation-features.ts",
        "test:invitation-features": "tsx --test src/lib/invitation-features/__tests__/*.test.ts",
        "db:seed-music": "tsx scripts/seed-music-library.ts",
        "music:sync": "tsx scripts/sync-music-assets.ts",
        "db:ensure-admin": "tsx scripts/ensure-admin.ts",
        "seed:admin": "tsx scripts/seed-admin.ts",
        "db:deploy": "prisma db push && tsx scripts/seed-admin.ts",
        "migrations:validate:sqlite": "tsx scripts/validate-sqlite-migrations.ts",
        "migrations:test:sqlite": "tsx scripts/test-sqlite-migrations.ts",
        "jobs:worker": "tsx scripts/video-jobs-worker.ts",
        "video:worker": "tsx scripts/video-jobs-worker.ts",
        "video:backfill": "tsx scripts/backfill-video-playback.ts",
        "video:backfill:dry-run": "tsx scripts/backfill-video-playback.ts --dry-run",
        "media:audit": "tsx scripts/media-audit.ts",
        "media:backfill": "tsx scripts/media-audit.ts --backfill",
        "media:backfill:dry-run": "tsx scripts/media-audit.ts --backfill --dry-run",
        "media:urls:fix": "tsx scripts/media-urls-fix.ts",
        "test:media-url": "tsx --test src/lib/uploads/__tests__/media-url.test.ts",
        "test:media-audit": "tsx --test src/lib/video/__tests__/media-audit-utils.test.ts",
        "test:transformstream-race": "tsx --test src/lib/runtime/__tests__/transformstream-race.test.ts",
        "test:uploads-stream-safe": "tsx --test src/app/api/uploads/__tests__/uploads-route.stream-safe.test.ts src/app/api/uploads/__tests__/range.test.ts",
        "probe:transformstream-race": "node scripts/probe-transformstream-race.cjs",
        "admission:backfill": "tsx scripts/backfill-guest-passes.ts",
        "admission:backfill:dry-run": "tsx scripts/backfill-guest-passes.ts --dry-run",
        "smoke-test": "node scripts/smoke-test-local.mjs",
        "smoke-test:pages": "node scripts/smoke-test-local.mjs && node scripts/smoke-test-authed-pages.mjs",
        "smoke:live": "node scripts/smoke-live-pages.mjs",
        "test:auth": "tsx --test src/lib/auth/__tests__/*.test.ts",
        "test:video": "tsx --test src/lib/video/__tests__/*.test.ts",
        "test:video-pipeline": "tsx --test --test-concurrency=1 src/lib/video/__tests__/integration/*.test.ts",
        "test:uploads": "tsx --test src/app/api/uploads/__tests__/*.test.ts",
        "test:experience-engine": "tsx --test src/lib/experience-engine/__tests__/*.test.ts",
        "test:live-editability": "tsx --test src/lib/invitation/__tests__/*.test.ts",
        "test:currency": "tsx --test src/services/commerce/__tests__/*.test.ts",
        "test:social": "tsx --test src/lib/social/__tests__/*.test.ts",
        "test:app-url": "tsx --test src/lib/__tests__/app-url.test.ts",
        "test:invitation-sharing": "tsx --test src/services/invitation-os/__tests__/*.test.ts",
        "test:gifts": "tsx --test src/lib/gifts/__tests__/*.test.ts src/services/gifts/__tests__/*.test.ts",
        "test:qr-hub": "tsx --test src/lib/qr-hub/__tests__/*.test.ts",
        "test:admission": "tsx --test src/lib/admission/__tests__/*.test.ts src/lib/admission-identity/__tests__/*.test.ts src/lib/vendor-pass/__tests__/*.test.ts src/lib/invitation/__tests__/*.test.ts",
        "test:admission-passes": "tsx --test --test-concurrency=1 src/services/admission/__tests__/*.test.ts",
        "admission:identity:audit": "tsx scripts/audit-admission-identity.ts --dry-run",
        "audit:party-isolation": "tsx scripts/audit-party-isolation-live.ts --dry-run",
        "audit:party-isolation:json": "tsx scripts/audit-party-isolation-live.ts --dry-run --json",
        "repair:party-isolation:dry": "tsx scripts/repair-party-isolation.ts --dry-run --only-high",
        "repair:party-isolation:apply": "tsx scripts/repair-party-isolation.ts --apply --only-high",
        "test:guest-import": "tsx --test src/lib/guest-import/__tests__/*.test.ts",
        "test:guest-import-e2e": "tsx --test --test-concurrency=1 src/services/guest-import/__tests__/*.test.ts",
        "test:guest-search": "tsx --test src/lib/guest-search/__tests__/*.test.ts",
        "test:guest-search-e2e": "tsx --test --test-concurrency=1 src/services/guest-search/__tests__/*.test.ts",
        "test:all": "npm run test:auth && npm run test:video && npm run test:media-audit && npm run test:transformstream-race && npm run test:uploads-stream-safe && npm run test:video-pipeline && npm run test:uploads && npm run test:experience-engine && npm run test:live-editability && npm run test:currency && npm run test:social && npm run test:app-url && npm run test:invitation-sharing && npm run test:gifts && npm run test:admission && npm run test:admission-passes && npm run test:guest-import && npm run test:guest-import-e2e && npm run test:guest-search && npm run test:guest-search-e2e",
        "db:studio": "prisma studio",
        "brand:assets": "node scripts/setup-brand-assets.mjs",
        "prepare:local": "node scripts/setup-brand-assets.mjs && npm run db:push",
        "postinstall": "prisma generate",
        "predev": "node scripts/setup-brand-assets.mjs"
    },
    "dependencies": {
        "@auth/prisma-adapter": "^2.9.1",
        "@aws-sdk/client-mediaconvert": "^3.1094.0",
        "@aws-sdk/client-s3": "^3.1091.0",
        "@aws-sdk/s3-request-presigner": "^3.1094.0",
        "@hookform/resolvers": "^5.0.1",
        "@prisma/client": "^6.9.0",
        "@radix-ui/react-avatar": "^1.1.10",
        "@radix-ui/react-checkbox": "^1.3.2",
        "@radix-ui/react-dialog": "^1.1.14",
        "@radix-ui/react-dropdown-menu": "^2.1.15",
        "@radix-ui/react-label": "^2.1.7",
        "@radix-ui/react-progress": "^1.1.7",
        "@radix-ui/react-select": "^2.2.5",
        "@radix-ui/react-separator": "^1.1.7",
        "@radix-ui/react-slot": "^1.2.3",
        "@radix-ui/react-switch": "^1.2.5",
        "@radix-ui/react-tabs": "^1.1.12",
        "@radix-ui/react-toast": "^1.2.14",
        "@react-three/drei": "^10.0.7",
        "@react-three/fiber": "^9.1.2",
        "@types/archiver": "^8.0.0",
        "archiver": "^8.0.0",
        "bcryptjs": "^3.0.2",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "date-fns": "^4.1.0",
        "framer-motion": "^12.16.0",
        "hls.js": "^1.6.16",
        "html5-qrcode": "^2.3.8",
        "ioredis": "^5.6.1",
        "lucide-react": "^0.513.0",
        "next": "^15.3.3",
        "next-auth": "^4.24.11",
        "otplib": "^12.0.1",
        "pdf-lib": "^1.17.1",
        "qrcode": "^1.5.4",
        "react": "^19.1.0",
        "react-dom": "^19.1.0",
        "react-hook-form": "^7.57.0",
        "sharp": "^0.33.5",
        "tailwind-merge": "^3.3.0",
        "three": "^0.176.0",
        "uuid": "^11.1.0",
        "zod": "^3.25.51"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.1",
        "@tailwindcss/postcss": "^4.1.8",
        "@types/bcryptjs": "^2.4.6",
        "@types/node": "^22.15.29",
        "@types/qrcode": "^1.5.5",
        "@types/react": "^19.1.6",
        "@types/react-dom": "^19.1.5",
        "@types/three": "^0.176.0",
        "@types/uuid": "^10.0.0",
        "eslint": "^9.28.0",
        "eslint-config-next": "^15.3.3",
        "prisma": "^6.9.0",
        "tailwindcss": "^4.1.8",
        "tsx": "^4.19.4",
        "typescript": "^5.8.3"
    }
}
